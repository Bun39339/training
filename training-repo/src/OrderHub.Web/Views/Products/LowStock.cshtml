@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存";
}

<h1 class="h3 mb-3">低庫存</h1>

<form asp-controller="Products" asp-action="LowStock" method="get" class="mb-3">
    <label asp-for="Threshold" class="form-label"></label>
    <div class="d-flex gap-2">
        <input asp-for="Threshold" name="threshold" type="number" min="1" class="form-control" />
        <button type="submit" class="btn btn-primary text-nowrap">查詢</button>
    </div>
    <span asp-validation-for="Threshold" class="text-danger"></span>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>SKU</th>
            <th>名稱</th>
            <th class="text-end">現有庫存</th>
            <th class="text-end">近 30 天售出數量</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr class="@(product.StockQuantity < 5 ? "table-danger" : null)">
                <td>@product.Sku</td>
                <td>@product.Name</td>
                <td class="text-end">@product.StockQuantity</td>
                <td class="text-end">@product.SoldQuantityLast30Days</td>
            </tr>
        }
    </tbody>
</table>
